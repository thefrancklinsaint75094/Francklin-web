TELEGRAM_BOT_TOKEN=         # obligatoire — obtenu via @BotFather
SUPABASE_URL=               # obligatoire
SUPABASE_SERVICE_KEY=       # obligatoire — clé service_role, pas anon
EXTRACTION_MODE=regles      # regles (sans IA) ou ia (Anthropic)
ANTHROPIC_API_KEY=          # obligatoire en mode ia
DISPATCH_TELEGRAM_ID=       # obligatoire — ton identifiant Telegram numérique
OPENAI_API_KEY=             # optionnel — sans elle, les vocaux sont refusés poliment
DEPARTEMENTS_AUTORISES=75,77,78,91,92,93,94,95
BROADCAST_WAVE_SIZE=3       # livreurs sollicités par vague
BROADCAST_WAVE_SECONDS=120  # délai avant d'élargir
POSITION_STALE_MINUTES=30   # au-delà, le livreur sort de la diffusion
SOON_FREE_RADIUS_METERS=400 # rayon de détection « bientôt libre »
DRAFT_EXPIRY_MINUTES=15     # durée de vie d'une fiche non confirmée
MAX_DISTANCE_KM=25          # au-delà, un livreur ne reçoit jamais la course
STUCK_COURSE_MINUTES=75     # course en cours depuis trop longtemps → alerte dispatch
PRICE_MAX=2000              # au-delà, le bot demande confirmation du prix
DATA_RETENTION_DAYS=90      # au-delà, digicodes et messages bruts sont effacés
NIGHT_START_HOUR=18
NIGHT_END_HOUR=6
